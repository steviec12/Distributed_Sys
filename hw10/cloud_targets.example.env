# Copy this to cloud_targets.env and fill in the real EC2 addresses.

# Leader-follower cluster
LF_NODE1=http://REPLACE_WITH_NODE1_PUBLIC_IP:8080
LF_NODE2=http://REPLACE_WITH_NODE2_PUBLIC_IP:8080
LF_NODE3=http://REPLACE_WITH_NODE3_PUBLIC_IP:8080
LF_NODE4=http://REPLACE_WITH_NODE4_PUBLIC_IP:8080
LF_NODE5=http://REPLACE_WITH_NODE5_PUBLIC_IP:8080
LF_LEADER=${LF_NODE1}

# Leaderless cluster
LL_NODE1=http://REPLACE_WITH_NODE1_PUBLIC_IP:8080
LL_NODE2=http://REPLACE_WITH_NODE2_PUBLIC_IP:8080
LL_NODE3=http://REPLACE_WITH_NODE3_PUBLIC_IP:8080
LL_NODE4=http://REPLACE_WITH_NODE4_PUBLIC_IP:8080
LL_NODE5=http://REPLACE_WITH_NODE5_PUBLIC_IP:8080
